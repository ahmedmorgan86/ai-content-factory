{
  "name": "Scenario 7: Multi-Platform Publishing Dispatcher & Safety Gate",
  "description": "Prepares and dispatches approved content to YouTube (via official YouTube Data API v3), schedules TikTok/Meta if authorized, or generates automated manual package with strict safety gates.",
  "modules": [
    {
      "id": 1,
      "module": "gateway:CustomWebhook",
      "version": 1,
      "parameters": {
        "name": "User Approval Signal"
      },
      "metadata": {
        "designer": { "x": 100, "y": 300 },
        "name": "Receive Approval Signal"
      }
    },
    {
      "id": 2,
      "module": "google-sheets:searchRows",
      "version": 2,
      "parameters": {
        "spreadsheetId": "{{connection.SPREADSHEET_ID}}",
        "sheetId": "Publishing",
        "filter": [
          [ "Idea ID", "equal", "{{1.idea_id}}" ]
        ]
      },
      "metadata": {
        "designer": { "x": 300, "y": 300 },
        "name": "Get Publishing Package"
      }
    },
    {
      "id": 3,
      "module": "builtin:Router",
      "version": 1,
      "metadata": {
        "designer": { "x": 550, "y": 300 },
        "name": "Platform Distribution Switcher"
      },
      "routes": [
        {
          "name": "YouTube Long & Shorts Official Upload",
          "filter": {
            "conditions": [
              [
                "{{2.Platform}}",
                "in",
                ["YouTube", "YouTube Shorts"]
              ]
            ]
          }
        },
        {
          "name": "TikTok & Meta Platforms",
          "filter": {
            "conditions": [
              [
                "{{2.Platform}}",
                "in",
                ["TikTok", "Instagram Reels", "Facebook Reels"]
              ]
            ]
          }
        }
      ]
    },
    {
      "id": 4,
      "module": "youtube:uploadVideo",
      "version": 1,
      "parameters": {
        "title": "{{2.Title}}",
        "description": "{{2.Description}}",
        "tags": "{{split(2.Tags; \", \")}}",
        "privacyStatus": "private",
        "videoFile": "{{2.VideoAssetUrl}}"
      },
      "metadata": {
        "designer": { "x": 800, "y": 150 },
        "name": "YouTube API: Upload as Private/Scheduled"
      }
    },
    {
      "id": 5,
      "module": "youtube:setThumbnail",
      "version": 1,
      "parameters": {
        "videoId": "{{4.id}}",
        "thumbnail": "{{2.ThumbnailUrl}}"
      },
      "metadata": {
        "designer": { "x": 1050, "y": 150 },
        "name": "YouTube API: Set Custom Thumbnail"
      }
    },
    {
      "id": 6,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {
        "spreadsheetId": "{{connection.SPREADSHEET_ID}}",
        "sheetId": "Publishing",
        "rowId": "{{2.__ROW_NUMBER__}}",
        "values": {
          "Post URL": "https://youtu.be/{{4.id}}",
          "Publishing Mode": "API Scheduled / Draft",
          "User Approval Status": "Approved",
          "Execution Log": "Successfully pushed to YouTube API"
        }
      },
      "metadata": {
        "designer": { "x": 1300, "y": 150 },
        "name": "Update Publishing Row"
      }
    },
    {
      "id": 7,
      "module": "telegram:sendMessage",
      "version": 1,
      "parameters": {
        "chatId": "{{connection.TELEGRAM_ADMIN_CHAT_ID}}",
        "parse_mode": "HTML",
        "text": "🎉 <b>تم تجهيز ورفع الفيديو بنجاح!</b>\n\n📌 <b>العنوان:</b> {{2.Title}}\n🔗 <b>الرابط المباشر:</b> https://youtu.be/{{4.id}}\n🔒 <b>الحالة:</b> مرفوع كـ Private/Scheduled للمراجعة النهائية\n\n🚀 مبروك! خط الإنتاج يعمل بكفاءة 100%!"
      },
      "metadata": {
        "designer": { "x": 1550, "y": 150 },
        "name": "Notify Telegram: Publish Complete"
      }
    }
  ]
}
