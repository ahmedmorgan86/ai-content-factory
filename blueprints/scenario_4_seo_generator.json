{
  "name": "Scenario 4: AI SEO & Metadata Package Generator",
  "description": "Generates 5 alternative titles, best title, platform descriptions, 20 tags, 5 hashtags, pinned comment, saves to Sheets and Drive.",
  "modules": [
    {
      "id": 1,
      "module": "gateway:CustomWebhook",
      "version": 1,
      "parameters": {
        "name": "SEO Generation Webhook"
      },
      "metadata": {
        "designer": { "x": 100, "y": 200 },
        "name": "Receive Idea & Script Payload"
      }
    },
    {
      "id": 2,
      "module": "openai-gpt-4:createChatCompletion",
      "version": 1,
      "parameters": {
        "model": "gpt-4o",
        "messages": [
          {
            "role": "system",
            "content": "You are the YouTube SEO & Growth Algorithm Specialist. Follow prompts/05_seo_generator_prompt.md."
          },
          {
            "role": "user",
            "content": "Generate full SEO package for Video: {{1.title}}, Script: {{1.script}}. Return strictly validated JSON."
          }
        ],
        "response_format": { "type": "json_object" }
      },
      "metadata": {
        "designer": { "x": 350, "y": 200 },
        "name": "OpenAI: SEO Synthesis"
      }
    },
    {
      "id": 3,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {
        "json": "{{2.choices[1].message.content}}"
      },
      "metadata": {
        "designer": { "x": 600, "y": 200 },
        "name": "Parse SEO Output"
      }
    },
    {
      "id": 4,
      "module": "google-sheets:addRow",
      "version": 2,
      "parameters": {
        "spreadsheetId": "{{connection.SPREADSHEET_ID}}",
        "sheetId": "SEO",
        "values": [
          "SEO-{{1.idea_id}}",
          "{{1.idea_id}}",
          "{{3.recommended_best_title}}",
          "{{3.alternative_titles[1]}}",
          "{{3.alternative_titles[2]}}",
          "{{3.alternative_titles[3]}}",
          "{{3.alternative_titles[4]}}",
          "{{3.alternative_titles[5]}}",
          "{{3.youtube_description}}",
          "{{3.short_description_reels_tiktok}}",
          "{{join(3.tags_20, \", \")}}",
          "{{join(3.hashtags_5, \" \")}}",
          "{{join(3.primary_keywords, \", \")}}",
          "{{join(3.secondary_keywords, \", \")}}",
          "{{3.pinned_comment}}",
          "{{join(3.related_video_ideas, \", \")}}"
        ]
      },
      "metadata": {
        "designer": { "x": 850, "y": 200 },
        "name": "Record SEO in Google Sheets"
      }
    },
    {
      "id": 5,
      "module": "google-drive:uploadAFile",
      "version": 1,
      "parameters": {
        "folderId": "{{1.folder_id}}",
        "fileName": "seo_metadata_{{1.idea_id}}.json",
        "data": "{{2.choices[1].message.content}}"
      },
      "metadata": {
        "designer": { "x": 1100, "y": 200 },
        "name": "Upload SEO Metadata JSON to Drive"
      }
    }
  ]
}
