# Gemini generation (required for production generation)
GEMINI_API_KEY=

# Firestore metadata database (optional; otherwise local CSV files are used)
FIRESTORE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudflare R2 media storage (optional; needed for persistent media on Vercel)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional public base URL; leave blank to return short-lived signed URLs internally
R2_PUBLIC_BASE_URL=

# Optional site origin for CORS
APP_ORIGIN=
# Optional admin bearer token. When set, protect all /api/* endpoints.
APP_ADMIN_TOKEN=
